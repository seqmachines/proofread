# The app is served under /proofread (next.config.ts basePath); NEXT_PUBLIC_BASE_PATH is set from it at build time.
# Backend base URL, called directly from the browser (CORS). Default when unset: http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
# sse (default) → EventSource on /runs/{id}/stream?since=N, reconnects from the last seq
# poll          → GET /runs/{id}/events?since=N once a second
NEXT_PUBLIC_STREAM_MODE=sse
# Reviewer id recorded on reviews until author invites exist (M15); role is always curator
NEXT_PUBLIC_REVIEWER=curator
